  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.22.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
