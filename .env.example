# Supabase dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never commit, never share.
# Supabase dashboard -> Project Settings -> API Keys -> Secret keys
SUPABASE_SECRET_KEY=sb_secret_xxx

# Where the app lives. Used for the QR code until a site_url is set in the database.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
